
# ============================================================
# Lenny Growth Assistant — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- App ---
PROJECT_NAME="The Lenny Growth Assistant"
PORT=8000
AGENT_VERBOSE=1
PI_AGENT_PORT=8001
PI_AGENT_URL="http://127.0.0.1:8001"
PI_AGENT_TIMEOUT_SECONDS=120
PI_AGENT_REQUEST_TIMEOUT_MS=110000
FASTAPI_INTERNAL_URL="http://127.0.0.1:8000"
INTERNAL_TOOL_TOKEN=""
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Database (Supabase PostgreSQL + pgvector OR Local Docker PostgreSQL) ---
# 
# OPTION 1: LOCAL (Evaluator Default) — Docker runs PostgreSQL locally
#   Leave DATABASE_URL blank → uses postgresql://postgres:postgres@postgres:5432/oogwayylabs
#   Change POSTGRES_PASSWORD if needed for security
#
# OPTION 2: CLOUD (Production) — Use Supabase PostgreSQL
#   Get DATABASE_URL from: https://app.supabase.com
#   → Project Settings → Database → Connection string (URI)
#   → Copy full URI including password and port
#   Example: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#   When set, backend ignores local PostgreSQL and connects to Supabase
#
DATABASE_URL=""
POSTGRES_PASSWORD="postgres"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# --- LLM: Google Gemini (chat + embeddings) ---
# Free API key from: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_CHAT_MODEL="gemini-3.6-flash"
GEMINI_CHAT_FALLBACK_MODELS=""
GEMINI_EMBED_MODEL="gemini-embedding-001"
GEMINI_EMBED_FALLBACK_MODELS=""
# Must match the embedding model output dimension.
VECTOR_DIMENSIONS=3072

# --- LLM: Ollama (local, runs in Docker container via docker-compose) ---
# For Docker: Ollama automatically runs in its own container
# For local dev (outside Docker): Install https://ollama.com and run: ollama pull llama3.1:8b
OLLAMA_MODEL="llama3.1:8b"

# --- RAG / Knowledge Base ---
TRANSCRIPTS_GITHUB_REPO="ChatPRD/lennys-podcast-transcripts"
TRANSCRIPTS_GITHUB_PATH="episodes"
TRANSCRIPTS_GITHUB_BRANCH="main"
# 0 indexes all available episodes. Set a small positive number for local testing.
INGEST_MAX_EPISODES=0
RAG_TOP_K=6
# Minimum similarity score (0.0–1.0) a chunk must reach to be returned.
# Raise this to get fewer but more relevant results; lower it for broader coverage.
RAG_SIMILARITY_THRESHOLD=0.55
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
